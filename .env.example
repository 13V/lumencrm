# Create Supabase in ap-southeast-2 (Sydney). Put production values in Vercel, never Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://127.0.0.1:3000
# Generate independent random secrets of at least 32 bytes.
CRM_INGEST_SECRET=
CRON_SECRET=
OUTCOMES_EXPORT_TOKEN=
# ClickSend: same sender as Chloe. No inbound webhook is registered by the CRM.
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=
# Verify sender domain in Resend.
RESEND_API_KEY=
CRM_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# CAPI is disabled by default in database settings. Read token is separate.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_API_VERSION=v26.0
META_ADS_READ_TOKEN=
META_AD_ACCOUNT_ID=
# Generate once with web-push generate-vapid-keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CHLOE_TAKEOVER_URL=
AI_PROVIDER_API_KEY=
# Optional Anthropic model for draft-only helpers. No automatic sending.
AI_MODEL=claude-haiku-5-5
# Local fictional preview only. Ignored in production. Never enable with real data.
LUMEN_DEMO_MODE=false
# Optional encrypted backup key: 32 bytes, base64 encoded. Kept separate from Storage.
BACKUP_ENCRYPTION_KEY=
